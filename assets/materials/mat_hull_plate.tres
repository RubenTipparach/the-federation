[gd_resource type="StandardMaterial3D" format=3]

; The hull under the ship systems display, for hulls that do not ship a
; painted material of their own. Dimmer and less emissive than the tactical
; hull material so the plate's panels stay the thing being read, with enough
; shading left for the silhouette to have depth.
;
; Colors are the project palette's navy and blue (data/palette.json, CLAUDE.md
; 3.1) written as normalized floats, because a .tres cannot read that file.
; Changing the palette means changing these two lines by hand.

[resource]
albedo_color = Color(0.121569, 0.176471, 0.211765, 1)
metallic = 0.1
roughness = 0.85
emission_enabled = true
emission = Color(0.141176, 0.321569, 0.450980, 1)
emission_energy_multiplier = 1.0
