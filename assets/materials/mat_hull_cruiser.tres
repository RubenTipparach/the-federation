[gd_resource type="StandardMaterial3D" load_steps=3 format=3]

; The Wayfarer's paint. Same construction as the frigate's material: one
; diffuse atlas and one emissive lights map. Unshaded is deliberately off:
; the flat panels want a little shading to read as a hull from the tactical
; camera, but the light map does the windows and the engine bells. The
; multiplier stays moderate so the glow colors keep their hue instead of
; clipping to white.

[ext_resource type="Texture2D" path="res://assets/textures/hull_cruiser_diffuse.png" id="1"]
[ext_resource type="Texture2D" path="res://assets/textures/hull_cruiser_lights.png" id="2"]

[resource]
albedo_texture = ExtResource("1")
texture_filter = 0
roughness = 0.75
metallic = 0.05
emission_enabled = true
emission_energy_multiplier = 1.4
emission_texture = ExtResource("2")
