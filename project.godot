; Godot project configuration.
;
; Minimal project shell so the export pipeline has something to build. M1 in
; docs/07-roadmap.md replaces the placeholder main scene with the tactical
; prototype. Gameplay belongs in code, not here, per CLAUDE.md section 5.2.
;
; Managed by the Godot editor. Hand edits are fine for the sections below, but
; the editor will rewrite formatting when it next saves.

config_version=5

[application]

config/name="The Federation"
config/description="Tactical space MMO. Pre-production."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
; No config/icon yet. Godot's default new-project icon is an .svg, and
; CLAUDE.md section 3 requires art assets to be delivered as .png, so the
; icon is left unset until a real .png icon exists.

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Mobile is a testing surface for this prototype, not the primary one. Landscape
; only, because the tactical layout is wide and unusable in portrait.
window/handheld/orientation="sensor_landscape"

[rendering]

; gl_compatibility, not forward_plus: Vulkan does not run in a browser, and the
; Web build is a project priority. Also the safest desktop default.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; Nearest, because every texture in this game is pixel art and Godot's default
; is Linear. The skin plates are between 24x20 and 48x22 and are nine patched
; across panels hundreds of pixels wide, so linear filtering was interpolating
; a two pixel bevel into a soft gradient and turning single pixel details into
; blurry smudges. The bitmap font is the same story at a smaller scale.
;
; This is the canvas default, so it covers every Control and Sprite2D without
; each one setting texture_filter for itself, which is section 5.4: one place
; rather than a property on forty nodes that a forty first will forget.
rendering/textures/canvas_textures/default_texture_filter=0
