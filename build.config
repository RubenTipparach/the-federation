# Build and deploy configuration.
#
# Single source of truth for the build pipeline, per CLAUDE.md section 5.4:
# tuning values live in a committed, diffable config file, never inline in
# scripts or workflow YAML.
#
# Sourced by scripts/lib/common.sh. Shell syntax, KEY=value only, no logic.

# --- Godot -------------------------------------------------------------------

# VERIFY BEFORE FIRST RUN: this pin was written without network access to
# github.com (blocked by egress policy in the authoring session), so the exact
# release could not be confirmed to exist. scripts/install-godot.sh prints the
# URL it tried on failure, so a wrong pin fails loudly and is a one line fix.
GODOT_VERSION="4.5"
GODOT_RELEASE="stable"

# "mono" for the .NET/C# build, "standard" for GDScript only.
# docs/06-technical-architecture.md section 2 selects C#, so "mono".
# Note: this is what makes the Web target unavailable. See docs/08.
GODOT_FLAVOR="mono"

# .NET SDK version, only used when GODOT_FLAVOR is "mono".
DOTNET_VERSION="8.0.x"

# --- itch.io -----------------------------------------------------------------

# The itch.io target, as it appears in the project URL:
#   https://<ITCH_USER>.itch.io/<ITCH_GAME>
# VERIFY: ITCH_GAME must match an existing project on itch.io. butler cannot
# create projects, so the first push fails if the page does not exist yet.
ITCH_USER="rubentipparach"
ITCH_GAME="the-federation"

# --- Targets -----------------------------------------------------------------

# Which targets a bare ./scripts/build.sh and ./scripts/deploy-itch.sh act on.
# Space separated, drawn from the TARGETS table below.
#
# macos and web are defined but not enabled. See docs/08-build-and-deploy.md
# section 6 for what each one needs before it can be turned on.
ENABLED_TARGETS="linux windows"

# Target table. One row per target, pipe delimited:
#
#   name | godot preset | output subdir | output filename | butler channel
#
# - "godot preset" must match a preset name in export_presets.cfg exactly.
# - "butler channel" names are chosen so itch.io auto detects the platform.
# - macos exports a .zip; every other desktop target exports a bare binary.
TARGETS="
linux   | Linux           | linux   | the-federation.x86_64 | linux
windows | Windows Desktop | windows | the-federation.exe    | windows
macos   | macOS           | macos   | the-federation.zip    | osx
web     | Web             | web     | index.html            | html5
"

# --- Paths -------------------------------------------------------------------

# Build output root, relative to the repository root. Git ignored.
BUILD_DIR="builds"

# Where install-godot.sh and install-butler.sh put their tools. Git ignored.
TOOLS_DIR=".tools"
