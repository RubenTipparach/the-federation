[gd_scene load_steps=4 format=3]

; A trail of embers behind something flying: ten authored puffs, laid down in
; WORLD space and left there, so the thing that shed them sails on and the
; sparks hang where they were shed. The Puffs node is top_level for exactly
; that reason; see the plume note in scenes/subsystem_fire.tscn, which is the
; same trick on a burning hull.
;
; Its own scene rather than more nodes inside the wreck, because a trail is a
; thing more than one effect will want (the subsystem fire's smoke plume is
; the same shape and predates this component; if the two ever converge, they
; converge HERE, per CLAUDE.md 4.1). Ten puffs, because the laydown interval
; times ten is comfortably past a puff's life: fewer and a puff is recycled
; while it is still bright, which cuts the trail off in mid air.

[ext_resource type="Script" path="res://src/ui/ember_trail.gd" id="1"]
[ext_resource type="ArrayMesh" path="res://assets/meshes/sprite_disc.obj" id="2"]
[ext_resource type="Material" path="res://assets/materials/mat_ember_trail.tres" id="3"]

[node name="EmberTrail" type="Node3D"]
script = ExtResource("1")

[node name="Puffs" type="Node3D" parent="."]
top_level = true

[node name="P0" type="MeshInstance3D" parent="Puffs"]
mesh = ExtResource("2")
material_override = ExtResource("3")
cast_shadow = 0

