[gd_scene load_steps=6 format=3]

; A destroyed ship: the explosion, and nine hull plates thrown clear of it.
;
; Nine because that is enough for a cruiser to read as coming apart and few
; enough that two of them at once cost nothing. Three plate shapes, used three
; times each and given different scales, rotations and directions in code, so
; no two chunks look alike without three more committed meshes.
;
; The fire is scenes/explosion.tscn, instanced rather than reimplemented. A
; wreck is one caller of a detonation and there will be others (a torpedo going
; off against a shield, a reactor letting go), so the fire lives in its own
; scene and this one only says where it goes. CLAUDE.md 4.1.

[ext_resource type="Script" path="res://src/ui/wreck.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/explosion.tscn" id="2"]
[ext_resource type="ArrayMesh" path="res://assets/meshes/debris_0.obj" id="3"]
[ext_resource type="ArrayMesh" path="res://assets/meshes/debris_1.obj" id="4"]
[ext_resource type="ArrayMesh" path="res://assets/meshes/debris_2.obj" id="5"]

[node name="Wreck" type="Node3D"]
script = ExtResource("1")

[node name="Explosion" parent="." instance=ExtResource("2")]

[node name="Chunks" type="Node3D" parent="."]

