[gd_scene load_steps=5 format=3]

; A dead rock: cratered ground and no air at all, so no cloud layer and no limb.
;
; The art is a 2D pixel shader from Deep-Fold (assets/vendor/pixel_planets,
; docs/14), so it is rendered into a viewport and shown on a card that faces the
; camera. A sphere projects to a circle from every direction, so a billboard is
; not an approximation of a sphere here, it is the shape of one.
;
; Field is the ring marking where the gravity well starts, and it lies on the
; combat plane rather than facing the camera, because unlike the planet a well
; is genuinely flat.

[ext_resource type="Script" path="res://src/ui/pixel_planet.gd" id="1"]
[ext_resource type="PackedScene" path="res://assets/vendor/pixel_planets/NoAtmosphere/NoAtmosphere.tscn" id="2"]
[ext_resource type="ArrayMesh" path="res://assets/meshes/ring.obj" id="3"]
[ext_resource type="Material" path="res://assets/materials/mat_well_ring.tres" id="4"]

[node name="Planet" type="Node3D"]
script = ExtResource("1")

[node name="Render" type="SubViewport" parent="."]
size = Vector2i(100, 100)
transparent_bg = true
; ONCE, not ALWAYS. The vendored planet shaders contain no TIME uniform at
; all (checked: zero references across all seven), so every frame after the
; first renders pixel for pixel what is already in the target. src/ui/
; pixel_planet.gd asks for one more update whenever it places or repaints a
; world, which is the only moment the output can differ.
render_target_update_mode = 1
disable_3d = true
gui_disable_input = true

[node name="Planet" parent="Render" instance=ExtResource("2")]
offset_left = 0.0
offset_top = 0.0
offset_right = 100.0
offset_bottom = 100.0

[node name="Body" type="Sprite3D" parent="."]
billboard = 1
shaded = false
transparent = true
alpha_cut = 1
texture_filter = 0
render_priority = 1

[node name="Field" type="MeshInstance3D" parent="."]
mesh = ExtResource("3")
material_override = ExtResource("4")
cast_shadow = 0
