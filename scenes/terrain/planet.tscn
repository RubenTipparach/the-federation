[gd_scene load_steps=11 format=3]

; A world. One scene draws every kind, because one shader does.
;
; Body is a sphere the shader does not use as geometry: it ray traces a noise
; displaced sphere and only needs fragments generated in front of it, which is
; why the mesh is scaled a little larger than the world it holds and why it
; needs no texture coordinates. It is a committed .obj either way.
;
; Atmosphere is a second, larger shell drawn additively with no depth write, so
; the air reaches past the limb over the stars while the body keeps its depth.
; That separation is ours; the glow inside it is the author's (docs/14).
;
; Noise is a 3D noise texture, sampled rather than computed. That is the single
; biggest reason this runs at a sensible speed: the surface is read six times
; per fragment for the terrain and three more for its slope.
;
; Ring is the gas giant's, hidden on every other world. Field is the ring
; marking where the well starts, and it lies on the combat plane rather than
; facing the camera, because unlike the planet a well is genuinely flat.
;
; Every colour and every number here is set from data by src/ui/planet_body.gd:
; the values below are only what the editor shows before a battle places one.
;
; THE THREE MATERIALS ARE LOCAL TO THE SCENE, and that is not decoration. A
; sub resource is SHARED by every instance of a scene unless it says otherwise,
; so without this line every world in an arena wrote its colours and its radius
; into one material and the last one placed won. A gas giant with a moon was
; drawn at the moon's radius, which at tactical range is a body so small it
; reads as missing: its ring and its atmosphere were still there, at the right
; size, around nothing. The noise texture below is deliberately NOT local,
; because one field shared by every world is the point of it.

[ext_resource type="Script" path="res://src/ui/planet_body.gd" id="1"]
[ext_resource type="ArrayMesh" path="res://assets/meshes/sphere.obj" id="2"]
[ext_resource type="Shader" path="res://assets/vendor/realtime_planet/planet.gdshader" id="3"]
[ext_resource type="Shader" path="res://assets/vendor/realtime_planet/atmosphere.gdshader" id="7"]
[ext_resource type="Shader" path="res://assets/shaders/planet_ring.gdshader" id="8"]
[ext_resource type="ArrayMesh" path="res://assets/meshes/ring.obj" id="4"]
[ext_resource type="ArrayMesh" path="res://assets/meshes/planet_ring.obj" id="6"]
[ext_resource type="Material" path="res://assets/materials/mat_well_ring.tres" id="5"]

[sub_resource type="FastNoiseLite" id="noise"]
noise_type = 2
seed = 1701
frequency = 0.03
fractal_octaves = 3

[sub_resource type="NoiseTexture3D" id="noise_tex"]
width = 64
height = 64
depth = 64
seamless = true
noise = SubResource("noise")

[sub_resource type="ShaderMaterial" id="planet"]
resource_local_to_scene = true
shader = ExtResource("3")
shader_parameter/radius = 50.0
shader_parameter/sunDirection = Vector3(0, 0, 1)
shader_parameter/sunIntensity = 1.7
shader_parameter/ambientLight = 0.07
shader_parameter/noiseTexture = SubResource("noise_tex")
shader_parameter/terrainScale = 1.0
shader_parameter/noiseStrength = 0.06
shader_parameter/waterLevel = 0.0
shader_parameter/sandLevel = 0.028
shader_parameter/treeLevel = 0.03
shader_parameter/rockLevel = 0.1
shader_parameter/iceLevel = 0.15
shader_parameter/transitionWidth = 0.02
shader_parameter/cloudsDensity = 0.55
shader_parameter/cloudsScale = 3.0
shader_parameter/cloudsSpeed = 1.0
shader_parameter/abyssColor = Color(0.078, 0.122, 0.145, 1)
shader_parameter/seaColor = Color(0.141, 0.322, 0.451, 1)
shader_parameter/shoreColor = Color(0.635, 0.624, 0.494, 1)
shader_parameter/landColor = Color(0.373, 0.482, 0.325, 1)
shader_parameter/peakColor = Color(0.565, 0.486, 0.459, 1)
shader_parameter/capColor = Color(0.89, 0.867, 0.82, 1)
shader_parameter/cloudColor = Color(0.89, 0.867, 0.82, 1)
shader_parameter/glowColor = Color(0, 0, 0, 1)
shader_parameter/glowLevel = 0.25
shader_parameter/bands = 0.0
shader_parameter/bandScale = Vector2(16, 4)
shader_parameter/distortionStrength = 0.4
shader_parameter/spin = 0.02
shader_parameter/worldSeed = 0.0

[sub_resource type="ShaderMaterial" id="air"]
resource_local_to_scene = true
shader = ExtResource("7")
render_priority = 1
shader_parameter/radius = 50.0
shader_parameter/sunDirection = Vector3(0, 0, 1)
shader_parameter/sunIntensity = 1.7
shader_parameter/atmosphereColor = Color(0.494, 0.663, 0.812, 1)
shader_parameter/atmosphereDensity = 1.0

[sub_resource type="ShaderMaterial" id="ring"]
resource_local_to_scene = true
shader = ExtResource("8")
shader_parameter/noiseTexture = SubResource("noise_tex")
shader_parameter/innerEdge = 0.74
shader_parameter/ringColor = Color(0.565, 0.424, 0.188, 1)
shader_parameter/ringColorAlt = Color(0.851, 0.722, 0.4, 1)
shader_parameter/ringDensity = 0.62
shader_parameter/ringGap = 0.44
shader_parameter/ringGapWidth = 0.075
shader_parameter/ringDetail = 9.0
shader_parameter/worldSeed = 0.0
shader_parameter/planetRadius = 50.0
shader_parameter/sunDirection = Vector3(0, 0, 1)
shader_parameter/shadowDepth = 0.82

[node name="Planet" type="Node3D"]
script = ExtResource("1")

[node name="Body" type="MeshInstance3D" parent="."]
mesh = ExtResource("2")
material_override = SubResource("planet")
cast_shadow = 0
extra_cull_margin = 16384.0

[node name="Atmosphere" type="MeshInstance3D" parent="."]
