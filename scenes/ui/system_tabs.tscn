[gd_scene load_steps=3 format=3]

; A strip of subsystem station tabs. Every station has an authored button here
; and the strip shows the subset its side asks for, so the two strips in the
; tactical view are two instances of ONE scene rather than two scenes that can
; drift (CLAUDE.md 4.1 and 5.1). What each button says and does comes from
; data/stations.json; this file only says the buttons exist.
;
; A column, sixty pixels wide, beside the panel it opens. It was a grid of wide
; icon and text buttons above the panel; a column of stencils costs a sliver of
; width instead of a band of height, which is what gives the panel beside it
; the room to be read.
;
; The width is fixed rather than a floor (CLAUDE.md 6.4). The panel beside it
; is sized by arithmetic from this number, so a strip that grew would move the
; panel, and a panel that moves is the thing section 6.4 exists to stop.

[ext_resource type="Script" path="res://src/ui/system_tabs.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/system_tab.tscn" id="2"]

[node name="SystemTabs" type="VBoxContainer"]
custom_minimum_size = Vector2(60, 0)
custom_maximum_size = Vector2(60, -1)
propagate_maximum_size = true
size_flags_horizontal = 0
size_flags_vertical = 0
theme_override_constants/separation = 3
script = ExtResource("1")

[node name="shields" parent="." instance=ExtResource("2")]
layout_mode = 2

[node name="reactor" parent="." instance=ExtResource("2")]
layout_mode = 2

[node name="sensors" parent="." instance=ExtResource("2")]
layout_mode = 2

[node name="tractor" parent="." instance=ExtResource("2")]
layout_mode = 2

[node name="marines" parent="." instance=ExtResource("2")]
layout_mode = 2

[node name="shuttle" parent="." instance=ExtResource("2")]
layout_mode = 2

[node name="repair" parent="." instance=ExtResource("2")]
layout_mode = 2

[node name="life" parent="." instance=ExtResource("2")]
layout_mode = 2

[node name="cargo" parent="." instance=ExtResource("2")]
layout_mode = 2

[node name="science" parent="." instance=ExtResource("2")]
layout_mode = 2

; Not a station: the settings panel, reachable from inside a battle. It is on
; the strip because the strip is the only chrome the tactical view keeps, and
; because CLAUDE.md 6.2 says the menu button is how a battle pauses. It is
; last, below every station, and only the strip that asks for it shows it.

[node name="Settings" parent="." instance=ExtResource("2")]
visible = false
layout_mode = 2
