[gd_scene load_steps=2 format=3]

; A pressable card with a title and a subtitle, reused by the hull list, the
; skirmish design list, the enemy list and the shipyard's saved designs
; (CLAUDE.md 4.1: one card, four callers, parameterized rather than cloned).
;
; It carried a delete button for a while, for the saved designs. Discarding a
; design now lives on the ship systems display beside the design it would
; throw away, so the card is a card again.

[ext_resource type="Script" path="res://src/ui/select_card.gd" id="1"]

[node name="SelectCard" type="Button"]
custom_minimum_size = Vector2(0, 77)
size_flags_horizontal = 3
toggle_mode = true
clip_text = true
script = ExtResource("1")

[node name="Body" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 14
offset_top = 10
offset_right = -14
offset_bottom = -10
mouse_filter = 2

; TRIM_ELLIPSIS, and it is load bearing rather than cosmetic. Without it this
; Label's minimum width is the whole string, which makes the Body's minimum
; width the whole string, which grows the Body wider than the card and paints
; the title outside the plate. That is invisible in a wide column and obvious
; in a narrow one with a delete button in it (CLAUDE.md 6.4).

[node name="Title" type="Label" parent="Body"]
layout_mode = 2
text = "Title"
text_overrun_behavior = 1

[node name="Meta" type="Label" parent="Body"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "meta"
autowrap_mode = 2
