[node name="F0" type="Label" parent="Side/Families"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "WEAPON"

[node name="F1" type="Label" parent="Side/Families"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "POWER"

[node name="F2" type="Label" parent="Side/Families"]
