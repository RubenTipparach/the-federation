[gd_scene load_steps=5 format=3]

; The ship systems display: the six facing shield ring, the hull integrity in
; the middle of it, and the subsystem slots beside it. One component, used for
; the player's own ship and for the target, and it will be used again in the
; fleet roster and the post battle report (CLAUDE.md 6.1). What varies between
; those is parameters, never a second scene: whether the slots take clicks,
; and whether box by box detail is shown at all.
;
; The ring is a Control._draw data visualisation, which section 7 already
; excepts: its content IS the shield array and no static node tree can
; describe a ring whose box count is the ship's own shield strength.

[ext_resource type="Script" path="res://src/ui/ship_display.gd" id="1"]
[ext_resource type="Script" path="res://src/ui/ssd_control.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/ui/sys_line.tscn" id="3"]
[ext_resource type="PackedScene" path="res://scenes/ui/hull_view.tscn" id="4"]

[node name="ShipDisplay" type="HBoxContainer"]
theme_override_constants/separation = 7
script = ExtResource("1")

[node name="Ring" type="Control" parent="."]
custom_minimum_size = Vector2(149, 149)
layout_mode = 2
script = ExtResource("2")

; The ship itself, as a wireframe, inside the shield ring. First child so it
; paints under the integrity reading rather than over it, and placed by the
; ring in code because only the ring knows where its shields are.
;
; A line drawing rather than the painted hull the shipyard shows: this one is
; an instrument, and a photograph of a ship competes with the damage state
; drawn around it.

[node name="Wire" parent="Ring" instance=ExtResource("4")]
modulate = Color(1, 1, 1, 1)
layout_mode = 0
mouse_filter = 2

; Hull integrity, at the foot of the ring rather than in the middle of it. The
; middle belongs to the ship now, and a number printed across a drawing of the
; ship makes neither readable. It stops short of the very bottom because the
; ring paints its own #4 label there.

[node name="Hull" type="Label" parent="Ring"]
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -40.0
offset_top = -44.0
offset_right = 40.0
offset_bottom = -23.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
horizontal_alignment = 1
vertical_alignment = 1
theme_override_font_sizes/font_size = 15
text = "100%"
clip_text = true

[node name="Side" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Slots" type="GridContainer" parent="Side"]
layout_mode = 2
columns = 4
theme_override_constants/h_separation = 3
theme_override_constants/v_separation = 3

[node name="S0" parent="Side/Slots" instance=ExtResource("3")]
layout_mode = 2

[node name="S1" parent="Side/Slots" instance=ExtResource("3")]
layout_mode = 2

[node name="S2" parent="Side/Slots" instance=ExtResource("3")]
layout_mode = 2

[node name="S3" parent="Side/Slots" instance=ExtResource("3")]
layout_mode = 2

[node name="S4" parent="Side/Slots" instance=ExtResource("3")]
layout_mode = 2

[node name="S5" parent="Side/Slots" instance=ExtResource("3")]
layout_mode = 2

[node name="S6" parent="Side/Slots" instance=ExtResource("3")]
layout_mode = 2

[node name="S7" parent="Side/Slots" instance=ExtResource("3")]
layout_mode = 2

[node name="S8" parent="Side/Slots" instance=ExtResource("3")]
layout_mode = 2

[node name="S9" parent="Side/Slots" instance=ExtResource("3")]
layout_mode = 2

[node name="S10" parent="Side/Slots" instance=ExtResource("3")]
