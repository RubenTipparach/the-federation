[gd_scene load_steps=7 format=3]

; The body of whichever subsystem station is open. One authored panel serves
; all ten: the rows are authored here and each station shows and configures
; the ones it needs, which is the same pattern as the tab strip and keeps
; CLAUDE.md 5.1 intact.
;
; Repair sits at the bottom rather than inside each station, because the
; answer to "this console is dark" is the same everywhere: fix the box.

[ext_resource type="Script" path="res://src/ui/subsystem_panel.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/stat_row.tscn" id="2"]
[ext_resource type="Script" path="res://src/ui/tug_bar.gd" id="3"]
[ext_resource type="Script" path="res://src/ui/marine_strip.gd" id="4"]
[ext_resource type="Script" path="res://src/ui/tow_dial.gd" id="5"]
[ext_resource type="Script" path="res://src/ui/tow_slider.gd" id="6"]

[node name="SubsystemPanel" type="PanelContainer"]
clip_contents = true
script = ExtResource("1")

[node name="V" type="VBoxContainer" parent="."]
theme_override_constants/separation = 7

[node name="Head" type="HBoxContainer" parent="V"]
layout_mode = 2

[node name="Title" type="Label" parent="V/Head"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 14
text = "STATION"

[node name="Badge" type="Label" parent="V/Head"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "LIVE"

