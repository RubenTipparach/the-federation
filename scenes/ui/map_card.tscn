[gd_scene load_steps=3 format=3]

; One arena in the skirmish map picker: a plan of a real placement, and the
; name under it. The plan is an ArenaMap, which paints the simulation's own
; circles (CLAUDE.md section 7 data driven chart exception).

[ext_resource type="Script" path="res://src/ui/map_card.gd" id="1"]
[ext_resource type="Script" path="res://src/ui/arena_map.gd" id="2"]

[node name="MapCard" type="Button"]
custom_minimum_size = Vector2(0, 125)
size_flags_horizontal = 3
toggle_mode = true
script = ExtResource("1")

[node name="V" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 6
offset_top = 6
offset_right = -6
offset_bottom = -5
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Plan" type="Control" parent="V"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
script = ExtResource("2")

[node name="Name" type="Label" parent="V"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
horizontal_alignment = 1
clip_text = true
text = "MAP"
