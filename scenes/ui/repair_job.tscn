[gd_scene format=3]

; One job in the repairs queue: its place in the order, the committed icon of
; the box being worked on, the code, which facing it is in, what it costs, and
; a way off the list. The progress track under it is filled only for the job
; actually under way, because Federation Commander 5G4 works one box at a time
; and a second bar would say otherwise.

[node name="RepairJob" type="VBoxContainer"]
theme_override_constants/separation = 2

[node name="Line" type="HBoxContainer" parent="."]
theme_override_constants/separation = 6

[node name="Ord" type="Label" parent="Line"]
custom_minimum_size = Vector2(14, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 7
text = "1"

[node name="Icon" type="TextureRect" parent="Line"]
custom_minimum_size = Vector2(19, 19)
layout_mode = 2
size_flags_vertical = 4
expand_mode = 1
stretch_mode = 5

[node name="Code" type="Label" parent="Line"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 7
text = "CODE"

[node name="Where" type="Label" parent="Line"]
custom_minimum_size = Vector2(29, 0)
layout_mode = 2
horizontal_alignment = 2
theme_override_font_sizes/font_size = 7
text = "#1"

[node name="Cost" type="Label" parent="Line"]
custom_minimum_size = Vector2(46, 0)
layout_mode = 2
horizontal_alignment = 2
theme_override_font_sizes/font_size = 7
text = "0 p"

[node name="Drop" type="Button" parent="Line"]
custom_minimum_size = Vector2(22, 0)
layout_mode = 2
focus_mode = 0
flat = true
theme_override_font_sizes/font_size = 7
text = "x"

[node name="Track" type="ColorRect" parent="."]
custom_minimum_size = Vector2(0, 4)
layout_mode = 2

[node name="Fill" type="ColorRect" parent="Track"]
layout_mode = 1
anchors_preset = 9
anchor_bottom = 1.0
grow_vertical = 2
